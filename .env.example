# Local/Pi config -- do NOT commit real values (install.sh chmods this to 600).
# Copy to .env and: set -a; source .env; set +a
TELEGRAM_BOT_TOKEN=123456:AA_your_bot_token_from_BotFather
TELEGRAM_CHAT_ID=your_chat_id_from_--get-chat-id
# Optional: override the listings URL if --probe found a different one
# KEREBY_URL=https://kereby.dk/ledige-boliger/
# RENDER_JS=true            # set if the page turns out to be JavaScript-rendered
# STATE_FILE=/var/lib/kereby-watch/seen.json   # set by the Pi installer
# Optional filters:
# MAX_PRICE=20000
# MIN_ROOMS=3
# MIN_SQM=70
# AREAS=Kobenhavn O,2100,Frederiksberg
# Health warnings (unattended runs):
# FAIL_ALERT_AFTER=3        # failed runs in a row before a "broken" message
# FAIL_ALERT_HOURS=6        # don't repeat that warning more often than this
